generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  income
  expense
  internalTransaction
}

model Transaction {
  id           Int      @id @default(autoincrement())
  date         DateTime
  description  String
  category     String
  account      String
  mandatory    Boolean
  amount       Float
  type         TransactionType
}